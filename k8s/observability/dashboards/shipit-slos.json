{"panels":[{"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Availability SLI for shipit-api over the retention window (24h — the most this free-tier Prometheus keeps). Target: 99.9%.","fieldConfig":{"defaults":{"max":1,"min":0.9,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":0.9},{"color":"yellow","value":0.999},{"color":"green","value":0.999}]},"unit":"percentunit"},"overrides":[]},"gridPos":{"h":8,"w":8,"x":0,"y":0},"targets":[{"expr":"slo:shipit_api:http_availability:ratio_24h","legendFormat":"availability","refId":"A"}],"title":"Availability SLI (24h)","type":"stat"},{"datasource":{"type":"prometheus","uid":"prometheus"},"description":"Share of the 0.1% error budget already consumed in the last 24h. 100% = SLO breached.","fieldConfig":{"defaults":{"max":100,"min":0,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"yellow","value":50},{"color":"red","value":100}]},"unit":"percent"},"overrides":[]},"gridPos":{"h":8,"w":8,"x":8,"y":0},"targets":[{"expr":"slo:shipit_api:error_budget_consumed:ratio_24h * 100","legendFormat":"consumed","refId":"A"}],"title":"Error budget consumed","type":"gauge"},{"datasource":{"type":"prometheus","uid":"prometheus"},"description":"1x = burning budget exactly at the sustainable rate. The fast-burn alert fires at 14.4x, slow-burn at 6x.","fieldConfig":{"defaults":{"custom":{"drawStyle":"line","fillOpacity":10,"showPoints":"never"},"unit":"none"},"overrides":[]},"gridPos":{"h":8,"w":8,"x":16,"y":0},"targets":[{"expr":"slo:shipit_api:burn_rate:1h","legendFormat":"1h burn rate","refId":"A"},{"expr":"slo:shipit_api:burn_rate:6h","legendFormat":"6h burn rate","refId":"B"}],"title":"Burn rate","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"description":"p99 request latency against the 500ms SLO (the same threshold Flagger's canary analysis uses).","fieldConfig":{"defaults":{"custom":{"drawStyle":"line","fillOpacity":10,"showPoints":"never"},"unit":"s"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"shipit\"}[5m])))","legendFormat":"p99","refId":"A"}],"title":"p99 latency vs 500ms SLO","type":"timeseries"},{"datasource":{"type":"prometheus","uid":"prometheus"},"description":"5xx rate overlaid with request rate — the raw signal behind the burn-rate alerts.","fieldConfig":{"defaults":{"custom":{"drawStyle":"line","fillOpacity":0,"showPoints":"never"},"unit":"reqps"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"sum(rate(http_request_duration_seconds_count{namespace=\"shipit\"}[5m]))","legendFormat":"requests/s","refId":"A"},{"expr":"sum(rate(http_request_duration_seconds_count{namespace=\"shipit\",status=~\"5..\"}[5m]))","legendFormat":"5xx/s","refId":"B"}],"title":"Traffic vs errors","type":"timeseries"}],"schemaVersion":39,"tags":["shipit","slo"],"time":{"from":"now-6h","to":"now"},"timezone":"browser","title":"ShipIt SLOs","uid":"shipit-slos","version":1}